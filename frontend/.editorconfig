# editorconfig.org
root = true

[*.{js,ts,vue,jsx,tsx}]
indent_style = tab
# Quitamos indent_size para que el editor respete el tamaño del tab
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{yaml,yml}]
indent_style = space
indent_size = 2
